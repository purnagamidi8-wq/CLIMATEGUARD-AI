# ClimateGuard AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Security
JWT_SECRET=climateguard-ai-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite local zero-config database; can be set to postgresql://user:pass@localhost:5432/climateguard)
DATABASE_URL=sqlite:///./climateguard.db

# Weather APIs
# Open-Meteo is free and needs NO key.
# Optional OpenWeatherMap API key (leave blank to use Open-Meteo primary)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# AI / LLM Configuration
# Google Gemini API key for AI Agent reasoning and multilingual responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./data/chroma_db

# Demo Mode (Set True to force realistic offline demo scenarios for presentations)
DEMO_MODE=False
